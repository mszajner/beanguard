<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.beanguard</groupId>
        <artifactId>beanguard</artifactId>
        <version>0.1.5-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>beanguard-api</artifactId>
    <name>BeanGuard API</name>
    <description>Shared DTOs, exceptions, and validators for BeanGuard licence server/client communication.</description>
    <url>https://github.com/mszajner/beanguard</url>

    <scm>
        <connection>scm:git:git@github.com:mszajner/beanguard.git</connection>
        <developerConnection>scm:git:git@github.com:mszajner/beanguard.git</developerConnection>
        <url>https://github.com/mszajner/beanguard</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>Apache License 2.0</name>
            <url>https://github.com/mszajner/beanguard/blob/main/licenses/LICENSE-APACHE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <dependencies>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!--
        Activated with `mvn -Prelease deploy`. Publishes to Maven Central via
        the Sonatype Central Portal - requires:
          - a Sonatype account with the dev.beanguard namespace verified
            (domain verification: a TXT record on beanguard.dev's DNS, since
            this groupId isn't a github.io-style namespace GitHub OAuth can
            verify automatically)
          - a <server><id>central</id>... entry in ~/.m2/settings.xml (or CI
            secrets) with your Central Portal token
          - a GPG key pair; the public key uploaded to a keyserver, and
            gpg-agent configured (or GPG_PASSPHRASE) so maven-gpg-plugin can
            sign the artifacts non-interactively in CI
        None of this is needed for `mvn install`/`mvn test` - this profile is
        opt-in and only touches beanguard-api/beanguard-client.
    -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
