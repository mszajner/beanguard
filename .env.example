# ── Spring / Database ─────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres/app
SPRING_DATASOURCE_USERNAME=app
SPRING_DATASOURCE_PASSWORD=app

# ── Service URLs (used by admin/shop frontends) ───────────────────────────────
BEANGUARD_SERVER_URL=https://api.example.com
BEANGUARD_SHOP_URL=https://shop.example.com
BEANGUARD_ADMIN_URL=https://admin.example.com

# ── Admin panel — documentation link (optional, defaults to http://localhost:8003) ─
BEANGUARD_DOCS_URL=https://beanguard.dev
